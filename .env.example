# Copy to .env.local and fill in from your Supabase project:
# Dashboard → Project Settings → API
#
# Both are safe to expose in the browser. The anon key is public by design —
# row-level security in supabase/schema.sql is what actually keeps one
# student's rows away from another's, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini. Create one at https://aistudio.google.com/apikey
#
# Server-only, and deliberately NOT prefixed with NEXT_PUBLIC_ — anything with
# that prefix is inlined into the browser bundle, where a key can be read out
# of devtools and spent by anyone. This one is read in src/app/api/ai/route.ts,
# which runs on the server; the client posts a prompt to that route instead of
# calling Google directly.
GEMINI_API_KEY=
